MQTT_BROKER_HOST=your-vm-address-or-localhost-if-broker-is-on-this-vm
MQTT_BROKER_PORT=1883
MQTT_USERNAME=your-mqtt-username
MQTT_PASSWORD=your-mqtt-password
MQTT_TOPIC_PREFIX=devices/esp-prototype-01

# Gates the whole dashboard behind a single shared password (see /api/login
# in cloud_app.py) — required, since this app is meant to be reachable from
# the open internet. Pick a long random value, not a real word.
CLOUD_DASHBOARD_PASSWORD=change-me-to-something-long-and-random

# Signs the login session cookie. Optional — a random one is generated per
# process start if unset, which just means everyone's logged out whenever
# the app restarts. Set a fixed random value here to avoid that.
CLOUD_SESSION_SECRET=

# Optional: Telegram alert when the board goes offline / comes back.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
